# ---- 运行时环境与依赖（体积大、可重建）------------------------------------
.venv/
__pycache__/
*.py[cod]

# ---- 资料库与运行时状态 ---------------------------------------------------
# 这里放的是你自己的文档、会话记录、SDK home 与各类缓存（本机实测 30 MB 量级，
# 且含隐私内容），任何情况下都不该进仓库。
.docqa-web/
.docqa/
.tmp-run/

# ---- 本地配置与密钥（仓库只保留模板 .env.example）-------------------------
.env
*.env
!.env.example

# ---- 过程产物与日志 -------------------------------------------------------
*.log
